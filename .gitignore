/target
**/target
.env
contracts/trellis_core/.env
*.log

# IDE settings — user-specific, should not be tracked
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code settings — per-user tool permissions must never be committed,
# otherwise they auto-approve Bash/Write/Edit/WebFetch for anyone reviewing a PR.
.claude/

# Frontend build output — never commit generated artifacts.
frontend/dist/

# Frontend environment files — these may contain CONTRACT_ID, RPC_URL, and
# NETWORK_PASSPHRASE.  The frontend/.gitignore already covers these, but the
# root-level rules provide a safety net if git resolves ignore rules differently.
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Generated e2e environment file — written by tests/e2e/run.sh and may survive
# an interrupted run, so it must never be committed.
frontend/.env.e2e-generated

# Cargo.lock is tracked for the CLI binary crate to ensure reproducible builds.
# Unlike libraries, binary crates should commit their lockfile so that every
# developer and CI runner resolves identical dependency versions.

# cargo-mutants output
mutants.out/
mutants.out.old/
mutants-out/

# Benchmark and coverage tool outputs — generated by the benchmark and test
# commands documented in TESTING.md and used by CI.  These are artefacts, not
# sources, and must never be committed.
gas_costs.json
baseline.json
current.json
lcov.info