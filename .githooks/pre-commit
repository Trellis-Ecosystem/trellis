#!/usr/bin/env bash
# .githooks/pre-commit
#
# Pre-commit hook for the Trellis monorepo.
# Runs fast, staged-file-only checks before every commit:
#
#   Rust workspace  — cargo fmt --check, cargo clippy
#   Frontend        — oxlint (lint), tsc --noEmit (typecheck)
#   Secrets         — gitleaks (if installed) or trufflehog fallback
#
# SETUP (one-time, per clone):
#
#   git config core.hooksPath .githooks
#
# Or use the helper script:
#
#   ./scripts/install-hooks.sh
#
# SKIP (emergency bypass — use sparingly):
#
#   SKIP_HOOKS=1 git commit -m "..."
#
# Individual checks can be skipped:
#
#   SKIP_RUST_FMT=1   git commit ...  # skip cargo fmt check
#   SKIP_RUST_LINT=1  git commit ...  # skip cargo clippy
#   SKIP_JS_LINT=1    git commit ...  # skip oxlint
#   SKIP_TYPECHECK=1  git commit ...  # skip tsc --noEmit
#   SKIP_SECRETS=1    git commit ...  # skip secret scanning
#
# NOTE: This hook only checks files staged for the current commit, not the
# entire working tree, to keep commit times low.

set -euo pipefail

# ─── helpers ────────────────────────────────────────────────────────────────

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
RESET='\033[0m'

info()    { echo -e "${CYAN}[hook]${RESET} $*"; }
success() { echo -e "${GREEN}[hook] ✓${RESET} $*"; }
warn()    { echo -e "${YELLOW}[hook] ⚠${RESET} $*"; }
fail()    { echo -e "${RED}[hook] ✗${RESET} $*"; exit 1; }

# List files staged for commit (added, modified, renamed).
staged_files() {
  git diff --cached --name-only --diff-filter=ACM
}

# Check whether any staged file matches a given glob pattern.
has_staged() {
  staged_files | grep -qE "$1" 2>/dev/null
}

# ─── global bypass ──────────────────────────────────────────────────────────

if [[ "${SKIP_HOOKS:-0}" == "1" ]]; then
  warn "SKIP_HOOKS=1 set — bypassing all pre-commit checks."
  exit 0
fi

info "Running pre-commit checks (staged files only)…"
FAILED=0

# ─── 1. Rust formatting ─────────────────────────────────────────────────────

if [[ "${SKIP_RUST_FMT:-0}" != "1" ]] && has_staged '\.rs$'; then
  info "cargo fmt --check"
  if ! cargo fmt --all -- --check 2>&1; then
    echo ""
    echo -e "${RED}  Rust formatting errors found.${RESET}"
    echo -e "  Run ${CYAN}cargo fmt${RESET} to auto-fix, then re-stage the files."
    FAILED=1
  else
    success "cargo fmt"
  fi
fi

# ─── 2. Rust clippy ─────────────────────────────────────────────────────────

if [[ "${SKIP_RUST_LINT:-0}" != "1" ]] && has_staged '\.rs$'; then
  info "cargo clippy --workspace --all-targets -- -D warnings"
  if ! cargo clippy --workspace --all-targets -- -D warnings 2>&1; then
    echo ""
    echo -e "${RED}  Clippy warnings or errors found.${RESET}"
    echo -e "  Fix the issues above, then re-stage the files."
    FAILED=1
  else
    success "cargo clippy"
  fi
fi

# ─── 3. Frontend lint (oxlint) ──────────────────────────────────────────────

FRONTEND_STAGED_PATTERN='\.(ts|tsx|js|jsx|mts|cts)$'

if [[ "${SKIP_JS_LINT:-0}" != "1" ]] && has_staged "${FRONTEND_STAGED_PATTERN}"; then
  info "oxlint (frontend)"
  if ! (cd frontend && npm run lint 2>&1); then
    echo ""
    echo -e "${RED}  Lint errors found in frontend.${RESET}"
    echo -e "  Run ${CYAN}cd frontend && npm run lint${RESET} to review, fix, and re-stage."
    FAILED=1
  else
    success "oxlint"
  fi
fi

# ─── 4. Frontend typecheck ───────────────────────────────────────────────────

if [[ "${SKIP_TYPECHECK:-0}" != "1" ]] && has_staged "${FRONTEND_STAGED_PATTERN}"; then
  info "tsc --noEmit (frontend)"
  if ! (cd frontend && npm run typecheck 2>&1); then
    echo ""
    echo -e "${RED}  TypeScript type errors found.${RESET}"
    echo -e "  Run ${CYAN}cd frontend && npm run typecheck${RESET} to review and fix."
    FAILED=1
  else
    success "tsc typecheck"
  fi
fi

# ─── 5. Secret scanning ─────────────────────────────────────────────────────
#
# Prefers gitleaks (fast, purpose-built) then falls back to a basic regex
# scan for common secret patterns.  Neither scanner is a substitute for a
# full pre-receive hook on the server, but both catch the most common
# accidental commits (API keys, private keys, .env values).

if [[ "${SKIP_SECRETS:-0}" != "1" ]]; then
  if command -v gitleaks &>/dev/null; then
    info "gitleaks — scanning staged files for secrets"
    if ! gitleaks protect --staged --no-banner -q 2>&1; then
      echo ""
      echo -e "${RED}  gitleaks found potential secrets in staged files.${RESET}"
      echo -e "  Review the output above."
      echo -e "  If this is a false positive, add a ${CYAN}# gitleaks:allow${RESET} comment on the line"
      echo -e "  or update .gitleaks.toml with an allowlisted rule."
      FAILED=1
    else
      success "gitleaks"
    fi
  else
    # Fallback: grep staged content for common high-signal patterns.
    info "secret scan (basic regex — install gitleaks for a full scan)"
    SECRET_PATTERN='(PRIVATE KEY|-----BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE|ghp_[A-Za-z0-9]{36}|sk-[A-Za-z0-9]{48}|AKIA[0-9A-Z]{16}|xoxb-[0-9]+-[A-Za-z0-9-]+)'
    if git diff --cached -U0 | grep -qE "${SECRET_PATTERN}" 2>/dev/null; then
      echo ""
      echo -e "${RED}  Potential secrets detected in staged diff.${RESET}"
      echo -e "  Review your changes and remove any credentials before committing."
      echo -e "  Consider installing gitleaks for a more thorough scan:"
      echo -e "    ${CYAN}https://github.com/gitleaks/gitleaks#installing${RESET}"
      FAILED=1
    else
      success "secret scan (basic)"
    fi
  fi
fi

# ─── result ─────────────────────────────────────────────────────────────────

if [[ "${FAILED}" -ne 0 ]]; then
  echo ""
  echo -e "${RED}Pre-commit checks failed.${RESET} Fix the issues above and re-run git commit."
  echo -e "To bypass in an emergency: ${YELLOW}SKIP_HOOKS=1 git commit -m \"...\"${RESET}"
  exit 1
fi

success "All pre-commit checks passed."
exit 0
