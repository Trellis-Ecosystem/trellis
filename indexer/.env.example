# Soroban RPC endpoint the indexer polls (once, on behalf of every client).
RPC_URL=https://soroban-testnet.stellar.org
# Contract whose events are indexed.
CONTRACT_ID=CAUAO7CYKULE2K4EJMQ6LLRUHP7Y7JYOH6G2VBXKYG7PTETE3UZ3DU7Q
# SQLite database file. Back this file up — it is the only copy of events
# older than the RPC node's retention window.
DB_PATH=./data/trellis-events.db
# HTTP port for the query API and SSE stream.
PORT=8787
# How often to poll getEvents, in milliseconds.
POLL_INTERVAL_MS=5000
# Maximum number of concurrent SSE clients allowed.
MAX_SSE_CLIENTS=100
# Maximum number of concurrent SSE subscribers allowed from a single IP.
# Extra connections from the same IP are rejected with 429.
MAX_SSE_CLIENTS_PER_IP=10
# Disconnect an SSE client whose response buffer (writableLength) exceeds this
# many bytes, so a slow or stalled client cannot grow memory unboundedly.
MAX_SSE_BUFFER_BYTES=1048576
# Maximum allowed gap between the RPC latest ledger and the latest indexed
# ledger. When the gap exceeds this value, /health returns 503 (degraded).
MAX_LAG_LEDGERS=100
# Value of Access-Control-Allow-Origin. Set to the frontend's origin in production.
CORS_ORIGIN=*
#
# NOTE: PORT, POLL_INTERVAL_MS, MAX_SSE_CLIENTS and MAX_LAG_LEDGERS must all be
# positive integers. If any of them is invalid (e.g. a typo like
# POLL_INTERVAL_MS=abc), the indexer exits at startup with a clear error.
